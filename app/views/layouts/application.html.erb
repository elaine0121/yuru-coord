<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Yuru Coord" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      header {
        background-color: #f7f3ea;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #e0d8c8;
        margin-bottom: 20px;
      }
      header h1 {
        margin: 0;
        font-size: 20px;
      }
      header h1 a {
        color: #6b5b3e;
        text-decoration: none;
      }
      header nav {
        display: flex;
        align-items: center;
        gap: 20px;
      }
      header nav a {
        color: #4a4a4a;
        text-decoration: none;
      }
      header nav a:hover {
        text-decoration: underline;
      }
      header nav span {
        color: #8a7a5a;
        font-size: 14px;
      }
      .flash {
        max-width: 800px;
        margin: 0 auto 20px;
        padding: 12px 16px;
        border-radius: 6px;
        font-size: 15px;
      }
      .flash-notice {
        background-color: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
      }
      .flash-alert {
        background-color: #fdecea;
        color: #c62828;
        border: 1px solid #ef9a9a;
      }
      .form-errors {
        max-width: 800px;
        margin: 0 auto 20px;
        padding: 12px 16px;
        background-color: #fdecea;
        border: 1px solid #ef9a9a;
        border-radius: 6px;
        color: #c62828;
      }
      .form-errors ul {
        margin: 0;
        padding-left: 20px;
      }
    </style>
  </head>

  <body>
    <% if user_signed_in? %>
      <header>
        <h1><%= link_to "ゆるコーデ", root_path %></h1>
        <nav>
          <%= link_to "マイ洋服一覧", clothing_items_path %>
          <%= link_to "洋服を登録する", new_clothing_item_path %>
          <%= link_to "コーデ一覧", outfits_path %>
          <%= link_to "コーデを登録", new_outfit_path %>
          <span><%= current_user.email %></span>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete } %>
        </nav>
      </header>
    <% end %>

    <% if notice.present? %>
      <p class="flash flash-notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="flash flash-alert"><%= alert %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
