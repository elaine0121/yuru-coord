<h1>マイ洋服一覧</h1>

<% target_count = 5 %>
<% if @clothing_items.size < target_count %>
  <p style="padding: 8px 12px; background: #fff3cd; border-radius: 4px;">
    あと<%= target_count - @clothing_items.size %>着登録すると提案の幅が広がります
  </p>
<% elsif @clothing_items.size == target_count %>
  <p style="padding: 8px 12px; background: #d4edda; border-radius: 4px;">
    目標の5着に達しました！提案の幅が広がりました！
  </p>
<% end %>

<% if notice %>
  <p class="notice"><%= notice %></p>
<% end %>

<% if @clothing_items.any? %>
  <table>
    <thead>
      <tr>
        <th>カテゴリ</th>
        <th>種類</th>
        <th>色</th>
        <th>季節</th>
        <th>メモ</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @clothing_items.each do |item| %>
        <tr>
          <td><%= item.category.name %></td>
          <td><%= item.kind %></td>
          <td><%= item.color %></td>
          <td><%= item.suitable_season ? ClothingItem::SUITABLE_SEASON_LABELS[item.suitable_season.to_sym] : "未設定" %></td>
          <td><%= item.memo %></td>
          <td><%= link_to "詳細", clothing_item_path(item) %></td>
          <td><%= button_to "削除", clothing_item_path(item), method: :delete, data: { turbo_confirm: "本当に削除しますか？" } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>まだ洋服が登録されていません。洋服を登録しましょう！</p>
<% end %>

<%= link_to "洋服を登録する", new_clothing_item_path %>
