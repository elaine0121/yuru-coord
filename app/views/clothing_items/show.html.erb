<h1>洋服詳細</h1>

<p><strong>カテゴリ：</strong><%= @clothing_item.category.name %></p>
<p><strong>種類：</strong><%= @clothing_item.kind %></p>
<p><strong>色：</strong><%= @clothing_item.color.presence || "未設定" %></p>
<p><strong>メモ：</strong><%= @clothing_item.memo.presence || "未設定" %></p>
<p><strong>登録日時：</strong><%= @clothing_item.created_at.strftime("%Y-%m-%d %H:%M") %></p>

<%= link_to "一覧に戻る", clothing_items_path %>
